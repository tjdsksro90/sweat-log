# Supabase 프로젝트 설정 > API에서 복사한다. 로컬 개발은 `pnpm db:start` 출력값을 쓴다.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 푸시 알림. 키는 `pnpm exec web-push generate-vapid-keys`로 만든다. 공개 키만 브라우저에 노출된다.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# 푸시 서비스가 연락할 주소(https URL 또는 mailto:)
VAPID_SUBJECT=
# 서버 전용. 알림 받을 사람의 구독을 읽는 데만 쓴다. 로컬은 `pnpm exec supabase status -o env`의 SECRET_KEY
SUPABASE_SECRET_KEY=
